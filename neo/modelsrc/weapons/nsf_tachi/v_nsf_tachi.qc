$sequence "fire1" "anims/fire1.smd" activity ACT_VM_RECOIL1 1 fps 30 fadein 0.20 fadeout 0.20 snap node "2" { event AE_MUZZLEFLASH 0 "PISTOL MUZZLE" }
$sequence "fire2" "anims/fire2.smd" activity ACT_VM_RECOIL2 1 fps 30 fadein 0.20 fadeout 0.20 snap node "2" { event AE_MUZZLEFLASH 0 "PISTOL MUZZLE" }
$sequence "fire3" "anims/fire3.smd" activity ACT_VM_RECOIL3 1 fps 30 fadein 0.20 fadeout 0.20 snap node "2" { event AE_MUZZLEFLASH 0 "PISTOL MUZZLE" }
$sequence "fireempty" "anims/fireempty.smd" activity ACT_VM_DRYFIRE 1 fps 30 fadein 0.20 fadeout 0.20 node "2"
$sequence "draw" "anims/draw.smd" activity ACT_VM_DRAW 1 fps 30 fadein 0.20 fadeout 0.20 snap node "0"
$sequence "drawempty" "anims/drawempty.smd" fps 30 fadein 0.20 fadeout 0.20 node "0"
$sequence "reload" "anims/reload.smd" activity ACT_VM_RELOAD 1 fps 30 fadein 0.20 fadeout 0.20 node "0"
$sequence "holster" "anims/holster.smd" activity ACT_VM_HOLSTER 1 fps 30 fadein 0.20 fadeout 0.20 node "0"
$sequence "holsterempty" "anims/holsterempty.smd" activity ACT_VM_HOLSTER 1 fps 30 fadein 0.20 fadeout 0.20 node "0"
$sequence "idletolow" "anims/idletolow.smd" activity ACT_VM_LOWERED_TO_IDLE 1 fps 30 fadein 0.20 fadeout 0.20 transition "0" "1"
$sequence "lowtoidle" "anims/lowtoidle.smd" activity ACT_VM_IDLE_TO_LOWERED 1 fps 30 fadein 0.20 fadeout 0.20 transition "1" "0"
$sequence "lowidle" "anims/lowidle.smd" activity ACT_VM_IDLE_LOWERED 1 fps 30 fadein 0.20 fadeout 0.20 loop node "1"
$sequence "reloadempty" "anims/reloadempty.smd" activity ACT_VM_RELOAD_EMPTY 1 fps 30 fadein 0.20 fadeout 0.20 node "0"
